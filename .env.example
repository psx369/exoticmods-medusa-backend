# --- Connections (Railway will inject these from Postgres/Redis services) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa
REDIS_URL=redis://default:password@localhost:6379?family=0

# --- Secrets (use Railway ${{secret(32)}} in production) ---
JWT_SECRET=replace-me
COOKIE_SECRET=replace-me

# --- CORS (point to your public Railway domain) ---
STORE_CORS=https://your-medusa.up.railway.app
ADMIN_CORS=https://your-medusa.up.railway.app
AUTH_CORS=https://your-medusa.up.railway.app

# --- Backend URL (for admin asset paths) ---
BACKEND_URL=https://your-medusa.up.railway.app

# --- Mode & port ---
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
PORT=9000
NODE_ENV=production

# --- Email (Resend) ---
# Both must be set for the Resend notification provider to register. If either
# is missing, Medusa falls back to its default notification module and no
# transactional email is sent.
# RESEND_FROM_EMAIL must be a verified domain in Resend; onboarding@resend.dev
# works for testing but only delivers to your own Resend account address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Newsletter (Mailchimp) ---
# All three are required for the Mailchimp provider to register; if any is
# missing it is skipped and newsletter signups are no-ops.
# MAILCHIMP_SERVER is the prefix in your API key / dashboard URL, e.g. "us21".
# Mailchimp runs on its own "newsletter" channel so it does not displace the
# Resend provider that sends transactional email.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=
MAILCHIMP_LIST_ID=
MAILCHIMP_NEW_PRODUCTS_SUBJECT_LINE=Check out our new products!
MAILCHIMP_NEW_PRODUCTS_STOREFRONT_URL=https://your-storefront.example.com

# --- Telemetry ---
# Opt out of Medusa's anonymous analytics. Already baked into the Dockerfile;
# set here too for local/non-Docker runs.
MEDUSA_DISABLE_TELEMETRY=true

# --- Admin user (created on first boot, ignored thereafter) ---
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=change-me-on-first-login
